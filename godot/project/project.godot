; NO CARRIER, the Godot frontend. Open this folder in Godot 4.7 after
; godot/scripts/build.sh has put the extension in bin/ and the content in
; content/ (see godot/README.md).

config_version=5

[application]

config/name="NO CARRIER"
config/description="A hacking deckbuilder on a green screen."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.06, 0.03, 1)
